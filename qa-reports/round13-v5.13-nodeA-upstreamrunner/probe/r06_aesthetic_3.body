_op":false,"overshoot":false},{"loop":2,"change":"放寬 occupation 維度：移除職業別限制。occupation 並非本問題的核心條件，且是目前唯一可有效提升樣本數的非核心維度。","match_count_before":4,"match_count_after":10,"filters_changed":true,"protected_veto":false,"vetoed_dims":[],"widened_dims":[],"no_op":false,"overshoot":false},{"loop":3,"change":"移除家庭收入（family_income）維度。此維度與性別同為非核心中可放寬的首選，但性別在醫美主題上仍具輔助精準度；家庭收入並非本問題核心條件，核心在醫美經歷、年齡、教育，故優先移除家庭收入。","match_count_before":10,"match_count_after":11,"filters_changed":true,"protected_veto":false,"vetoed_dims":[],"widened_dims":[],"no_op":false,"overshoot":false}],"broadening_stop_reason":"loop_limit","protected_dims":["aesthetic_procedure","age","education"],"applied_filters":{"age":["25-34","35-44","45-54"],"sex":["女"],"income":["3-8萬",">8萬"],"marriage":["未婚","已婚"],"education":["大學","研究所以上"],"aesthetic_procedure":["有"]},"subject":"customer","subject_basis":"命中「醫美診所的目標客戶」（顧客語意樣式）","warnings":["模型宣告的保護維度超過上限 3 → 僅接受 ['aesthetic_procedure', 'age', 'education']（#66 A）","protected_dims 覆蓋 3/6 個已套用維度（['aesthetic_procedure', 'age', 'education']）→ 放寬空間受限（#66 A）"],"protected_dims_sources":{"domain":["aesthetic_procedure"],"reasoning":["aesthetic_procedure"],"analysis_declared":["aesthetic_procedure"],"model_declared":["aesthetic_procedure","age","education"],"protect_only":[]},"scoring_basis":{"method":"log-frequency × cross-dim normalized [0.5, 2.0]","weight_source":"DGBAS 113年 家庭收支調查 / 人力資源調查 / 交通部 2024","weight_version":"v5.13","score_scale":"relative-within-version","score_schema":1,"dims_counted":["age","sex","occupation","income","marriage","family_income","education","aesthetic_procedure","family_size"],"relaxed_dims_scored_at":null}}