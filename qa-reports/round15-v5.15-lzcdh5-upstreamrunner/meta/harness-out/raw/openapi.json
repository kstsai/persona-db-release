{"openapi": "3.1.0", "info": {"title": "Persona DB API", "description": "\u53f0\u7063\u4eba\u53e3\u52a0\u6b0a\u5408\u6210\u4eba\u8a2d\u8cc7\u6599\u5eab \u2014 LLM-powered \u67e5\u8a62\u8207\u6a21\u64ec API", "version": "3.2.0"}, "paths": {"/health": {"get": {"summary": "Health", "operationId": "health_health_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthResponse"}}}}}}}, "/personadb/candidates": {"get": {"summary": "Personadb Candidates", "operationId": "personadb_candidates_personadb_candidates_get", "parameters": [{"name": "questions", "in": "query", "required": true, "schema": {"type": "string", "description": "\u554f\u984c\u5217\u8868\uff0c\u7528 | \u5206\u9694\u591a\u984c", "title": "Questions"}, "description": "\u554f\u984c\u5217\u8868\uff0c\u7528 | \u5206\u9694\u591a\u984c"}, {"name": "top_k", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 100, "minimum": 1, "description": "\u8981\u56de\u50b3\u5e7e\u500b\u6700\u76f8\u95dc\u7684 persona", "default": 20, "title": "Top K"}, "description": "\u8981\u56de\u50b3\u5e7e\u500b\u6700\u76f8\u95dc\u7684 persona"}, {"name": "opMode", "in": "query", "required": false, "schema": {"type": "string", "description": "\u64cd\u4f5c\u6a21\u5f0f: \u7be9\u9078+\u6a21\u64ec / \u50c5\u7be9\u9078 / \u6a21\u64ec\u8a62\u554f", "default": "\u50c5\u7be9\u9078", "title": "Opmode"}, "description": "\u64cd\u4f5c\u6a21\u5f0f: \u7be9\u9078+\u6a21\u64ec / \u50c5\u7be9\u9078 / \u6a21\u64ec\u8a62\u554f"}, {"name": "role", "in": "query", "required": false, "schema": {"type": "string", "description": "\u8a62\u554f\u8005\u89d2\u8272\uff08\u4f8b\uff1a\u623f\u4ef2\u696d\u8005\u3001\u9280\u884c\u696d\u8005\uff09\u3002\u8b93 LLM \u8abf\u6574 filter \u65b9\u5411\u3002", "default": "", "title": "Role"}, "description": "\u8a62\u554f\u8005\u89d2\u8272\uff08\u4f8b\uff1a\u623f\u4ef2\u696d\u8005\u3001\u9280\u884c\u696d\u8005\uff09\u3002\u8b93 LLM \u8abf\u6574 filter \u65b9\u5411\u3002"}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CandidatesResponse"}}}}, "400": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}, "description": "Bad Request"}, "500": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}, "description": "Internal Server Error"}, "503": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}, "description": "Service Unavailable"}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/personadb/detail": {"get": {"summary": "Personadb Detail", "operationId": "personadb_detail_personadb_detail_get", "parameters": [{"name": "persona_id", "in": "query", "required": true, "schema": {"type": "string", "description": "Persona ID (TW-P-XXXX \u6216\u6578\u5b57)", "title": "Persona Id"}, "description": "Persona ID (TW-P-XXXX \u6216\u6578\u5b57)"}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DetailResponse"}}}}, "404": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}, "description": "Not Found"}, "500": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}, "description": "Internal Server Error"}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/personadb/status": {"get": {"summary": "Persona Db Status", "description": "Return persona-db status as raw text (like `hermes chat 'persona-db status'`).\nNo parameters needed.", "operationId": "persona_db_status_personadb_status_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {}}}}}}}}, "components": {"schemas": {"BroadeningAttempt": {"properties": {"loop": {"type": "integer", "title": "Loop", "description": "\u7b2c\u5e7e\u8f2a broadening\uff081 \u8d77\u7b97\uff09", "default": 0}, "change": {"type": "string", "title": "Change", "description": "LLM \u8aaa\u660e\u7684\u653e\u5bec\u5167\u5bb9\uff08\u4eba\u53ef\u8b80\uff09", "default": ""}, "match_count_before": {"type": "integer", "title": "Match Count Before", "description": "\u8a72\u8f2a\u653e\u5bec\u524d\u7684\u7b26\u5408\u6578", "default": 0}, "match_count_after": {"type": "integer", "title": "Match Count After", "description": "\u8a72\u8f2a\u653e\u5bec\u5f8c\u7684\u7b26\u5408\u6578", "default": 0}, "filters_changed": {"type": "boolean", "title": "Filters Changed", "description": "filters \u662f\u5426\u5be6\u969b\u8b8a\u66f4", "default": false}, "protected_veto": {"type": "boolean", "title": "Protected Veto", "description": "#57\uff1a\u8a72\u8f2a\u56e0\u89f8\u52d5\u53d7\u4fdd\u8b77\u7684\u6838\u5fc3\u7dad\u5ea6\u800c\u88ab\u9084\u539f\uff08\u672a\u751f\u6548\uff09", "default": false}, "vetoed_dims": {"items": {"type": "string"}, "type": "array", "title": "Vetoed Dims", "description": "#57\uff1a\u88ab\u5426\u6c7a\u7684\u7dad\u5ea6\uff08\u50c5 protected_veto=true \u6642\u975e\u7a7a\uff09", "default": []}, "widened_dims": {"items": {"type": "string"}, "type": "array", "title": "Widened Dims", "description": "#63\uff1a\u672c\u8f2a\u503c\u96c6\u88ab\u653e\u5bec\uff08\u65b0\u503c\u96c6\u70ba\u820a\u503c\u96c6\u7684\u56b4\u683c\u8d85\u96c6\uff09\u7684\u7dad\u5ea6\u2014\u2014\u7a3d\u6838\u7528\uff0c\u4e0d\u4f75\u5165 relaxed_dims", "default": []}, "widened_deltas": {"items": {"additionalProperties": true, "type": "object"}, "type": "array", "title": "Widened Deltas", "description": "#69\uff1a\u672c\u8f2a\u503c\u96c6\u653e\u5bec\u7684**\u5e45\u5ea6**\u2014\u2014`[{\"dim\", \"before\", \"after\", \"added\"}]`\uff08\u53e3\u5f91\u8207 `widened_dims` \u4e00\u81f4\uff1a\u56b4\u683c\u8d85\u96c6\uff09\u3002\u7528\u65bc\u7a3d\u6838\u300c\u9019\u4e00\u8f2a\u9b06\u4e86\u591a\u5c11\u300d", "default": []}, "overshoot_restore": {"type": "boolean", "title": "Overshoot Restore", "description": "#70 A\uff1a\u672c\u8f2a\u662f\u5426\u56e0**\u79fb\u9664\u7dad\u5ea6\u9020\u6210\u904e\u885d**\uff08\u6a23\u672c\u6578 \u22653\u00d7\uff09\u800c\u88ab\u9084\u539f\uff08\u8a72\u8f2a\u79fb\u9664\u4e0d\u7b97\u6578\uff09", "default": false}, "restored_dims": {"items": {"type": "string"}, "type": "array", "title": "Restored Dims", "description": "#70 A\uff1a\u88ab\u9084\u539f\u4e26\u52a0\u5165\u4fdd\u8b77\u96c6\uff08\u4f86\u6e90\u2465 `overshoot_restore`\uff09\u7684\u7dad\u5ea6", "default": []}, "parse_error": {"type": "boolean", "title": "Parse Error", "description": "#72\uff1a\u8a72\u8f2a LLM \u56de\u61c9**\u7121\u6cd5\u4f7f\u7528**\uff08\u7a7a\u56de\u61c9\u6216\u89e3\u6790\u5931\u6557\uff09\u2192 \u4ecd\u8a18\u5165 attempts\uff0c\u4f7f `len(broadening_attempts)` \u7b49\u65bc\u5be6\u969b\u547c\u53eb\u6b21\u6578", "default": false}, "error_type": {"type": "string", "title": "Error Type", "description": "#72\uff1a\u5931\u6557\u578b\u614b\uff08`empty_response` \u6216\u4f8b\u5916\u578b\u5225\u540d\u7a31\uff09\uff0c\u50c5\u5728 `parse_error=true` \u6642\u975e\u7a7a", "default": ""}, "no_op": {"type": "boolean", "title": "No Op", "description": "\u653e\u5bec\u5f8c\u6a23\u672c\u6578\u672a\u8b8a\uff08\uff1d\u7a7a\u8f49\uff09", "default": false}, "overshoot": {"type": "boolean", "title": "Overshoot", "description": "\u653e\u5bec\u5f8c\u6a23\u672c\u6578 > 2\u00d7TARGET_MIN\uff08\uff1d\u653e\u5bec\u904e\u982d\uff09", "default": false}}, "type": "object", "title": "BroadeningAttempt", "description": "broadening loop \u7684\u4e00\u6b21\u5617\u8a66\uff08#48\uff1a\u578b\u5225\u5316\uff0c\u8b93 OpenAPI \u7522\u751f properties \u800c\u975e\nadditionalProperties \u2014\u2014 codegen/\u9a57\u8b49\u5de5\u5177\u624d\u770b\u5f97\u5230\u9019\u4e9b\u6b04\u4f4d\uff09\u3002"}, "CandidatesResponse": {"properties": {"status": {"type": "string", "title": "Status", "default": "ok"}, "total_matched": {"type": "integer", "title": "Total Matched", "description": "\u7b26\u5408\u689d\u4ef6\u7684\u7e3d\u7b46\u6578"}, "persona_ids": {"items": {"type": "integer"}, "type": "array", "title": "Persona Ids", "description": "\u7b26\u5408\u689d\u4ef6\u7684 persona ID \u5217\u8868"}, "summary": {"items": {"$ref": "#/components/schemas/PersonaSummary"}, "type": "array", "title": "Summary", "description": "\u6458\u8981\u8868\u683c\uff08\u53d6\u4ee3\u5b8c\u6574 persona \u8a73\u7d30\u8cc7\u6599\uff09", "default": []}, "returned": {"type": "integer", "title": "Returned", "description": "\u5be6\u969b\u56de\u50b3\u7b46\u6578\uff08= len(summary)\uff09\uff1b\u53ef\u5c0f\u65bc top_k\uff0c\u898b pool_exhausted\uff08#43\uff09", "default": 0}, "pool_exhausted": {"type": "boolean", "title": "Pool Exhausted", "description": "\u7b26\u5408\u689d\u4ef6\u4eba\u6578 < top_k\uff08\u7cfb\u7d71\u62d2\u7d55\u70ba\u6e4a\u6578\u653e\u5bec\u6838\u5fc3\u7dad\u5ea6\uff0c\u6545\u56de\u50b3\u8f03\u5c11\uff1b#43\uff09", "default": false}, "important_dimensions": {"items": {"$ref": "#/components/schemas/DimensionSummary"}, "type": "array", "title": "Important Dimensions", "description": "\u91cd\u8981\u7dad\u5ea6", "default": []}, "llm_analysis": {"anyOf": [{"$ref": "#/components/schemas/LLMAnalysis"}, {"type": "null"}], "description": "LLM \u5c0d\u554f\u984c\u7684\u5206\u6790\uff08\u542b reasoning\uff09"}, "relaxed_dims": {"items": {"type": "string"}, "type": "array", "title": "Relaxed Dims", "description": "\u56e0 broadening \u88ab\u653e\u5bec\u79fb\u9664\u7684\u7dad\u5ea6\uff08\u7a7a = \u672a\u653e\u5bec\uff09", "default": []}, "broadening_attempts": {"items": {"$ref": "#/components/schemas/BroadeningAttempt"}, "type": "array", "title": "Broadening Attempts", "description": "broadening loop \u904e\u7a0b\uff08\u542b no_op / overshoot \u65d7\u6a19\uff1b#37/#42\uff09", "default": []}, "broadening_stop_reason": {"type": "string", "enum": ["", "target_reached", "no_op_limit", "loop_limit", "budget_limit", "llm_empty", "llm_parse_error", "llm_no_filters", "no_filters", "protected_veto", "protection_saturated"], "title": "Broadening Stop Reason", "description": "broadening \u505c\u6b62\u539f\u56e0\uff08#56\uff1b#57 \u65b0\u589e protected_veto\uff09\uff1atarget_reached / no_op_limit / loop_limit / budget_limit / llm_empty / llm_parse_error / llm_no_filters / no_filters / protected_veto\uff08\u8a72\u8f2a\u6b32\u79fb\u9664\u53d7\u4fdd\u8b77\u7684\u6838\u5fc3\u7dad\u5ea6 \u2192 \u5df2\u9084\u539f\uff09\u3002\u7a7a\u5b57\u4e32\uff1d\u672a\u9032\u5165\u8ff4\u5708\uff08\u547c\u53eb\u7aef\u81ea\u884c\u5efa\u69cb\u6642\u7684\u9810\u8a2d\u503c\uff09", "default": ""}, "protected_dims": {"items": {"type": "string"}, "type": "array", "title": "Protected Dims", "description": "#57\uff1a\u672c\u8acb\u6c42\u53d7\u4fdd\u8b77\u7684\u6838\u5fc3\u7dad\u5ea6\uff08domain \u8a9e\u610f \u222a \u5206\u6790\u6b65\u9a5f\u5fc5\u8981\u6027\u5ba3\u544a \u222a \u6a21\u578b\u81ea\u6211\u5ba3\u544a\uff09\u3002\u653e\u5bec\u6b65\u9a5f\u4e0d\u5f97\u79fb\u9664\u6216\u7e2e\u5c0f\u9019\u4e9b\u7dad\u5ea6 \u2014\u2014 \u9019\u662f v5.4 #43\u300c\u62d2\u7d55\u70ba\u6e4a\u6578\u800c\u653e\u5bec\u6838\u5fc3\u7dad\u5ea6\u300d\u7684\u6a5f\u5236\u5316", "default": []}, "applied_filters": {"additionalProperties": true, "type": "object", "title": "Applied Filters", "description": "\u5be6\u969b\u7528\u65bc\u7be9\u9078\u7684 filters\uff08LLM \u7522\u51fa\uff0c\u542b broadening \u5f8c\uff09", "default": {}}, "subject": {"type": "string", "title": "Subject", "description": "#65\uff1a\u672c\u8acb\u6c42\u7684**\u4e3b\u9ad4\u5224\u5b9a**\uff08\u6a5f\u68b0\u5316\uff0c\u53ea\u770b\u984c\u76ee\u539f\u6587\uff09\u2014\u2014 `customer`\uff08\u76ee\u6a19\u662f\u9867\u5ba2\uff0f\u6d88\u8cbb\u8005\uff09\uff0f`owner`\uff08\u76ee\u6a19\u662f\u696d\u4e3b\u672c\u4eba\uff09\uff0f\u7a7a\u5b57\u4e32\uff1d\